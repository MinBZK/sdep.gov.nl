# Application
APP_PREFIX=sdep

# Image
BACKEND_IMAGE_NAME=local/sdep-backend
BACKEND_IMAGE_VERSION=latest

# Database
POSTGRES_DB_NAME=sdep-data
POSTGRES_DB_USER=sdep
POSTGRES_DB_PASSWORD=sdep

# Database server
POSTGRES_CONTAINER_NAME=sdep-postgres
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://app:app@localhost:5432/sdep-data
POSTGRES_VERSION=17.6

# Database superuser
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=postgres

# Keycloak
KEYCLOAK_CONTAINER_NAME=sdep-keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=sdep
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_VERSION=26.2.4

# Keycloak (predefined by keycloak)
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_DB_PASSWORD=keycloak
KC_DB_URL=jdbc:postgresql://sdep-postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB=postgres
KC_HOSTNAME_STRICT_HTTPS=false
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true

# Backend (testing)
BACKEND_CONTAINER_NAME=sdep-backend
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000
BACKEND_KEYCLOAK_BASE_URL=http://sdep-keycloak:8080

# STR credentials (testing POST)
STR_CLIENT_ID=sdep-str-01
STR_CLIENT_SECRET=sdep-str-01

# CA credentials (testing GET)
CA_CLIENT_ID=sdep-ca-0363
CA_CLIENT_SECRET=sdep-ca-0363
