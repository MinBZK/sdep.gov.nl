{
  "classes": [
    {
      "name": "CompetentAuthority",
      "description": "Regulates short-term rental",
      "isComposite": false,
      "attributes": [
        {
          "name": "competentAuthorityId",
          "datatype": "string",
          "constraints": [
            "mandatory",
            "unique",
            "length functional id",
            "is auto-provisioned when receiving first POST from competent authority"
          ],
          "referencesClass": null
        },
        {
          "name": "competentAuthorityName",
          "datatype": "string",
          "constraints": [
            "optional",
            "length \"Gemeente Amsterdam\""
          ],
          "referencesClass": null
        },
        {
          "name": "areas",
          "datatype": "reference",
          "constraints": [],
          "referencesClass": "Area"
        }
      ],
      "constraints": [
        {
          "name": "unique",
          "definition": "{ competentAuthority, createdAt }"
        }
      ]
    },
    {
      "name": "Address",
      "description": null,
      "isComposite": false,
      "attributes": [
        {
          "name": "street",
          "datatype": "string",
          "constraints": [
            "mandatory",
            "length Turfmarkt"
          ],
          "referencesClass": null
        },
        {
          "name": "number",
          "datatype": "int",
          "constraints": [
            "mandatory",
            "e.g. 147"
          ],
          "referencesClass": null
        },
        {
          "name": "letter",
          "datatype": "string",
          "constraints": [],
          "referencesClass": null
        },
        {
          "name": "addition",
          "datatype": "string",
          "constraints": [],
          "referencesClass": null
        },
        {
          "name": "postalCode",
          "datatype": "string",
          "constraints": [
            "mandatory",
            "length 2500EA"
          ],
          "referencesClass": null
        },
        {
          "name": "city",
          "datatype": "string",
          "constraints": [
            "mandatory",
            "length Den Haag"
          ],
          "referencesClass": null
        }
      ],
      "constraints": []
    },
    {
      "name": "Area",
      "description": "Defines a geographic region for short-term rental",
      "isComposite": false,
      "attributes": [
        {
          "name": "areaId",
          "datatype": "string",
          "constraints": [
            "mandatory",
            "length when supplied then is e.g. \"area-0363\"",
            "when not supplied then is autogenerated conform RFC 6749"
          ],
          "referencesClass": null
        },
        {
          "name": "areaName",
          "datatype": "string",
          "constraints": [
            "optional",
            "length \"Amsterdam-Noord\""
          ],
          "referencesClass": null
        },
        {
          "name": "filename",
          "datatype": "string",
          "constraints": [
            "mandatory",
            "length \"Amsterdam.zip"
          ],
          "referencesClass": null
        },
        {
          "name": "filedata",
          "datatype": "largeBinary",
          "constraints": [
            "mandatory",
            "max size 1MiB",
            "e.g. a .zip with a collection of ESRI shapefile files"
          ],
          "referencesClass": null
        }
      ],
      "constraints": [
        {
          "name": "unique",
          "definition": "{ areaId, createdAt } # Todo: consider adding competentAuthority, because the same functional areaId can be used multiple"
        }
      ]
    },
    {
      "name": "Activity",
      "description": "Represents an actual rental activity",
      "isComposite": false,
      "attributes": [
        {
          "name": "activityId",
          "datatype": "string",
          "constraints": [
            "mandatory",
            "length when supplied then is e.g. \"activity-001\"",
            "when not supplied then is autogenerated conform RFC 6749"
          ],
          "referencesClass": null
        },
        {
          "name": "activityName",
          "datatype": "string",
          "constraints": [
            "optional",
            "length \"Summer rental\""
          ],
          "referencesClass": null
        },
        {
          "name": "platform",
          "datatype": "reference",
          "constraints": [],
          "referencesClass": "Platform"
        },
        {
          "name": "area",
          "datatype": "reference",
          "constraints": [],
          "referencesClass": "Area"
        },
        {
          "name": "url",
          "datatype": "string",
          "constraints": [
            "optional",
            "length http://example.com/my-advertisement\""
          ],
          "referencesClass": null
        },
        {
          "name": "address",
          "datatype": "reference",
          "constraints": [],
          "referencesClass": "Address"
        },
        {
          "name": "registrationNumber",
          "datatype": "string",
          "constraints": [
            "mandatory",
            "length"
          ],
          "referencesClass": null
        },
        {
          "name": "numberOfGuests",
          "datatype": "int",
          "constraints": [
            "optional",
            "min 1",
            "max 1024"
          ],
          "referencesClass": null
        },
        {
          "name": "countryOfGuests",
          "datatype": "array of string",
          "constraints": [
            "optional",
            "min 1",
            "max 1024",
            "each ISO 3166-1 alpha-3"
          ],
          "referencesClass": null
        },
        {
          "name": "temporal",
          "datatype": "reference",
          "constraints": [],
          "referencesClass": "Temporal"
        }
      ],
      "constraints": [
        {
          "name": "unique",
          "definition": "{ activityId, createdAt } # Todo: consider adding platformId because the same functional activityd can be used multiple"
        }
      ]
    },
    {
      "name": "Temporal",
      "description": null,
      "isComposite": false,
      "attributes": [
        {
          "name": "startDatetime",
          "datatype": "datetime",
          "constraints": [
            "mandatory",
            "year must be >= 2025"
          ],
          "referencesClass": null
        },
        {
          "name": "endDatetime",
          "datatype": "datetime",
          "constraints": [
            "mandatory"
          ],
          "referencesClass": null
        }
      ],
      "constraints": [
        {
          "name": "startBeforeEnd",
          "definition": "{ startDatetime < endDatetime }"
        }
      ]
    },
    {
      "name": "Platform",
      "description": "Delivers rental activities",
      "isComposite": false,
      "attributes": [
        {
          "name": "platformId",
          "datatype": "string",
          "constraints": [
            "mandatory",
            "length functional id",
            "is auto-provisioned when receiving first POST from platform"
          ],
          "referencesClass": null
        },
        {
          "name": "platformName",
          "datatype": "string",
          "constraints": [
            "optional",
            "length \"Example platform\""
          ],
          "referencesClass": null
        },
        {
          "name": "activities",
          "datatype": "reference",
          "constraints": [],
          "referencesClass": "Activity"
        }
      ],
      "constraints": [
        {
          "name": "unique",
          "definition": "{ platformId, createdAt }"
        }
      ]
    }
  ]
}